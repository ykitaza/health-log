{
  "expo": {
    "name": "ことば",
    "slug": "kotoba",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kotoba",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F3EC",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.ykitaza.kotoba",
      "adaptiveIcon": {
        "backgroundColor": "#F6F3EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F3EC"
        }
      ],
      "expo-sqlite",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2B4570"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      },
      "kotoba": {
        "clientId": "3evio7n5uuik3u1jlshp1ld645",
        "cognitoDomain": "https://oidc-study-969624666976.auth.ap-northeast-1.amazoncognito.com",
        "apiUrl": "https://grm9a7ydz6.execute-api.ap-northeast-1.amazonaws.com",
        "mcpUrl": ""
      }
    },
    "owner": "ponchulove"
  }
}
