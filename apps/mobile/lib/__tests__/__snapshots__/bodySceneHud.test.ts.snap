  uniform float uTime; uniform float uScanY; uniform float uScanAmp; uniform float uSel; uniform float uFade;
  varying vec3 vN; varying vec3 vV; varying float vY;
  void main() {
    float f = 1.0 - abs(dot(normalize(vN), normalize(vV)));
